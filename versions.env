# agent-jack-setup · the ONE tested combination (machine-readable; human view in VERSIONS.md).
# Every value is exact. TBD = not yet published; doctor reports it as FAIL AJ-PIN-00 until filled.
# Read by bin/*.sh (sourced) and bin/*.ps1 (parsed: KEY=VALUE, "# comment" stripped, quotes removed, $HOME expanded).
SETUP_TAG=v1.1.4
SETUP_REPO=https://github.com/m-check1B/agent-jack-setup
T3_REPO=https://github.com/pingdotgg/t3code   # the official T3 Code (Beta) app from upstream
T3_APP_NAME="T3 Code (Beta)"
T3_TAG=v0.1.11   # commit 59651c1761f6; the T3 version the Tentacles lock (src/t3-support.mjs T3_SUPPORT.testedThrough) was proven on
T3_VERSION=0.1.11
T3_MIN=0.1.8   # lowest supported T3 (Tentacles src/t3-support.mjs T3_SUPPORT.minimum); T3 updates itself, newer stable releases are kept
T3_BUNDLE_ID=com.t3tools.t3code
T3_ASSET_MAC_ARM64=T3-Code-0.1.11-arm64.dmg
T3_ASSET_MAC_X64=T3-Code-0.1.11-x64.dmg
T3_SHA256_MAC_ARM64=c4f4203c14c6f47fc530a9ecfdc4c01ee0c485aa16a68599da972c6e98131d62
T3_SHA256_MAC_X64=816617a16575005fa86d40afe80bfc2e4f9c31210a1b1b704464333175f6c676
T3_ASSET_WIN_X64=TBD   # official T3-Code-0.1.11-x64.exe exists (sha256 e54516240a74dccc099b878a5d0740b071e6796970c981c470c61ba2b337bfd6); stays TBD until a Windows proof run with stock T3, so doctor.ps1 keeps WAIT
T3_SHA256_WIN_X64=TBD
T3_LEGACY_APP_NAMES="T3 Code TPLUS|T3 Code (Alpha)"   # older apps the installer moves aside (never deletes)
TENTACLES_REPO=https://github.com/m-check1B/t3-code-tentacles
TENTACLES_TAG=v0.5.0-jack.19   # signs in to stock T3 Code (Beta) by itself on first run, skipping a leftover launcher of an older T3 app (KRA-10852, KRA-10860); desktop 3.17.68 still bundles jack.16
TENTACLES_VERSION=0.5.0-jack.19
TENTACLES_COMMIT=a80ca96b91abbf427648371392a968a32f17bf73
GUARDIAN_REPO=https://github.com/m-check1B/estate-guardian
GUARDIAN_TAG=v1.0.0
GUARDIAN_COMMIT=bbba0e26c61fe7a8b25484749ffb0b34a71db96b   # full commit: installs fetch this commit, the tag is for display (audit 5)
CLASSIFY_VERSION=0.3.0   # package version is not bumped per tag; the tag is the pin
CLASSIFY_VENV="$HOME/.agent-jack/venv"
PYTHON_MIN=3.11
CODEX_CLI_MIN=0.164.0   # Codex CLI = the "Local · Codex" lab; sign in locally with your own ChatGPT plan (codex login)
CLAUDE_CLI_MIN=2.1.310   # Claude Code updates itself, so this is a minimum, not an exact pin
CLAUDE_WINGET_ID=Anthropic.ClaudeCode   # Windows: winget portable package, user scope, no admin
JACK_DESKTOP_MIN=3.17.68   # Agent Jack is closed: installer only inside the signed-in web app, never on GitHub
NODE_MIN_MAJOR=22
NODE_VERSION=22.23.5   # macOS: the doctor installs this into ~/.agent-jack/node when no Node >= NODE_MIN_MAJOR is usable (no Homebrew needed)
NODE_SHA256_MAC_ARM64=e7131995759b61a0170b646010d2ad35a5d37b4cb0d471f3e8317eac6f742f3d   # nodejs.org/dist/v22.23.5/SHASUMS256.txt
NODE_SHA256_MAC_X64=c53383238206b9ae4db23c5d8a63645e2e753bec8ab51a49cc81939aa64e9422
MACOS_MIN_MAJOR=14
WINDOWS_MIN_BUILD=22000   # Windows 11
DISK_WARN_GB=20
DISK_FAIL_GB=5
