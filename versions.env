# agent-jack-setup · the ONE tested combination (machine-readable; human view in VERSIONS.md).
# Every value is exact. TBD = not yet published; doctor reports it as FAIL AJ-PIN-00 until filled.
SETUP_TAG=v1.0.2
T3_REPO=https://github.com/m-check1B/t3code-tplus
T3_APP_NAME="T3 Code TPLUS"
T3_TAG=v0.0.42-tplus.2   # commit 5a7381052e59; T3 Code 0.0.42 + turn-result patch for Tentacles
T3_VERSION=0.0.42-tplus.2
T3_BUNDLE_ID=com.verduona.t3code-tplus
T3_ASSET_MAC_ARM64=T3-Code-TPLUS-0.0.42-tplus.2-arm64.dmg
T3_ASSET_MAC_X64=T3-Code-TPLUS-0.0.42-tplus.2-x64.dmg
T3_SHA256_MAC_ARM64=0ea80df824bb6e3f3b00ff5e68c4eb1f6fe90350b6d36bace97ba58ce760200e
T3_SHA256_MAC_X64=02927633e5efc4a47ee98b7b2a56bbc7f379bcaec696a13c2fa745cca7769499
TENTACLES_REPO=https://github.com/m-check1B/t3-code-tentacles
TENTACLES_TAG=v0.4.1-jack.1
TENTACLES_VERSION=0.4.1-jack.1
GUARDIAN_REPO=https://github.com/m-check1B/estate-guardian
GUARDIAN_TAG=v1.0.0   # public commit bbba0e2
GUARDIAN_COMMIT=bbba0e2
CLASSIFY_VERSION=0.3.0   # package version is not bumped per tag; the tag is the pin
CLASSIFY_VENV="$HOME/.agent-jack/venv"
PYTHON_MIN=3.11
CODEX_CLI_MIN=0.162.1   # Codex CLI = the "Local · Codex" lab; sign in locally with your own ChatGPT plan (codex login)
CLAUDE_CLI_MIN=2.1.302   # Claude Code updates itself, so this is a minimum, not an exact pin
JACK_DESKTOP_MIN=3.17.41   # Agent Jack is closed: installer only inside the signed-in web app, never on GitHub
NODE_MIN_MAJOR=22
MACOS_MIN_MAJOR=13
DISK_WARN_GB=20
DISK_FAIL_GB=5
